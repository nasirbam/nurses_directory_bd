rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security & Validation Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string &&
             id.size() >= 5 &&
             id.size() <= 128 &&
             id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isBootstrapAdmin() {
      return hasVerifiedEmail() && normalizedEmail() == 'mdnasirnaznin@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(normalizedEmail()))
      );
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || (
        hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(normalizedEmail())) &&
        get(/databases/$(database)/documents/admins/$(normalizedEmail())).data.role == 'SUPER_ADMIN'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidAdmin(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
             data.email is string && isValidEmailId(data.email) &&
             data.role in ['SUPER_ADMIN', 'MODERATOR'] &&
             data.assignedDivision is string && data.assignedDivision.size() >= 2 && data.assignedDivision.size() <= 50 &&
             data.addedBy is string && data.addedBy.size() >= 2 && data.addedBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasValidHospitalOrAddress(data) {
      return data.hospitalName is string &&
             data.hospitalName.size() <= 120 &&
             (
               (!('nurseCategory' in data) || data.nurseCategory != 'NON_GOVT')
                 ? data.hospitalName.size() >= 3
                 : (
                     data.hospitalName.size() >= 3 ||
                     ('address' in data && data.address is string && data.address.size() >= 3)
                   )
             );
    }

    function isValidNurse(data) {
      return data.submittedByUid is string && data.submittedByUid.size() >= 1 && data.submittedByUid.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 80 &&
             (!('fatherName' in data) || (data.fatherName is string && data.fatherName.size() <= 80)) &&
             (!('motherName' in data) || (data.motherName is string && data.motherName.size() <= 80)) &&
             (!('nurseCategory' in data) || data.nurseCategory in ['GOVT', 'NON_GOVT', 'STUDENT']) &&
             data.bnmcNumber is string && data.bnmcNumber.size() >= 4 && data.bnmcNumber.size() <= 30 &&
             (!('govtUid' in data) || (data.govtUid is string && data.govtUid.size() <= 40)) &&
             data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 60 &&
             data.qualification is string && data.qualification.size() >= 2 && data.qualification.size() <= 200 &&
             (!('educations' in data) || (data.educations is list && data.educations.size() <= 10)) &&
             data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 60 &&
             data.division is string && data.division.size() >= 2 && data.division.size() <= 40 &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 40 &&
             (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             hasValidHospitalOrAddress(data) &&
             data.phone is string && data.phone.size() >= 11 && data.phone.size() <= 20 &&
             data.whatsapp is string && data.whatsapp.size() >= 11 && data.whatsapp.size() <= 20 &&
             data.email is string && data.email.size() <= 120 &&
             data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'] &&
             data.availabilityStatus in ['ON_DUTY', 'EMERGENCY_AVAILABLE', 'OFF_DUTY'] &&
             data.experienceYears is int && data.experienceYears >= 0 && data.experienceYears <= 60 &&
             data.bio is string && data.bio.size() <= 400 &&
             data.approvalStatus in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.rejectionReason is string && data.rejectionReason.size() <= 250 &&
             (!('reviewedBy' in data) || data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || (data.reviewedAt is timestamp && data.reviewedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransferRequest(data) {
      return data.nurseId is string && isValidId(data.nurseId) &&
             data.nurseName is string && data.nurseName.size() >= 3 && data.nurseName.size() <= 80 &&
             data.bnmcNumber is string && data.bnmcNumber.size() >= 4 && data.bnmcNumber.size() <= 30 &&
             data.requestedByUid is string && data.requestedByUid.size() >= 1 && data.requestedByUid.size() <= 128 &&
             (!('currentCategory' in data) || data.currentCategory in ['GOVT', 'NON_GOVT', 'STUDENT']) &&
             (!('newCategory' in data) || data.newCategory in ['GOVT', 'NON_GOVT', 'STUDENT']) &&
             (!('newGovtUid' in data) || (data.newGovtUid is string && data.newGovtUid.size() <= 40)) &&
             (!('newDesignation' in data) || (data.newDesignation is string && data.newDesignation.size() <= 60)) &&
             data.currentHospitalName is string && data.currentHospitalName.size() <= 120 &&
             data.currentDivision is string && data.currentDivision.size() >= 2 && data.currentDivision.size() <= 40 &&
             data.currentDistrict is string && data.currentDistrict.size() >= 2 && data.currentDistrict.size() <= 40 &&
             (!('currentUpazila' in data) || (data.currentUpazila is string && data.currentUpazila.size() <= 50)) &&
             data.newHospitalName is string && data.newHospitalName.size() >= 3 && data.newHospitalName.size() <= 120 &&
             data.newDivision is string && data.newDivision.size() >= 2 && data.newDivision.size() <= 40 &&
             data.newDistrict is string && data.newDistrict.size() >= 2 && data.newDistrict.size() <= 40 &&
             (!('newUpazila' in data) || (data.newUpazila is string && data.newUpazila.size() <= 50)) &&
             data.transferNote is string && data.transferNote.size() <= 250 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.rejectionReason is string && data.rejectionReason.size() <= 250 &&
             (!('reviewedBy' in data) || data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || (data.reviewedAt is timestamp && data.reviewedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveNotice(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.message is string && data.message.size() <= 400 &&
             data.active is bool &&
             data.updatedBy is string && data.updatedBy.size() >= 2 && data.updatedBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Admins Collection Rules
    match /admins/{adminEmail} {
      allow get: if hasVerifiedEmail() && isValidEmailId(adminEmail) && (
        normalizedEmail() == adminEmail || isAdmin()
      );
      allow list: if isAdmin();

      allow create: if hasVerifiedEmail() &&
                       isValidEmailId(adminEmail) &&
                       incoming().keys().hasAll(['fullName', 'email', 'role', 'assignedDivision', 'addedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['fullName', 'email', 'role', 'assignedDivision', 'addedBy', 'createdAt', 'updatedAt']) &&
                       incoming().email == adminEmail &&
                       isValidAdmin(incoming()) &&
                       (
                         isSuperAdmin() ||
                         (isBootstrapAdmin() && adminEmail == normalizedEmail() && incoming().role == 'SUPER_ADMIN')
                       );

      allow update: if hasVerifiedEmail() &&
                       isValidEmailId(adminEmail) &&
                       isValidAdmin(incoming()) &&
                       isSuperAdmin() &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'assignedDivision', 'updatedAt']);

      allow delete: if hasVerifiedEmail() &&
                       isValidEmailId(adminEmail) &&
                       isSuperAdmin() &&
                       adminEmail != normalizedEmail() &&
                       adminEmail != 'mdnasirnaznin@gmail.com';
    }

    // 5. Nurses Collection Rules
    match /nurses/{nurseId} {
      allow get: if isSignedIn() && isValidId(nurseId) && (
        existing().approvalStatus == 'APPROVED' ||
        existing().submittedByUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().approvalStatus == 'APPROVED' ||
        existing().submittedByUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(nurseId) &&
                       incoming().keys().hasAll([
                         'submittedByUid', 'fullName', 'bnmcNumber', 'designation',
                         'qualification', 'specialty', 'division', 'district',
                         'hospitalName', 'phone', 'whatsapp', 'email',
                         'bloodGroup', 'availabilityStatus', 'experienceYears',
                         'bio', 'approvalStatus', 'rejectionReason',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'submittedByUid', 'fullName', 'fatherName', 'motherName',
                         'nurseCategory', 'bnmcNumber', 'govtUid', 'designation',
                         'qualification', 'educations', 'specialty',
                         'division', 'district', 'upazila', 'address',
                         'hospitalName', 'phone', 'whatsapp', 'email',
                         'bloodGroup', 'availabilityStatus', 'experienceYears',
                         'bio', 'approvalStatus', 'rejectionReason',
                         'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidNurse(incoming()) &&
                       incoming().submittedByUid == request.auth.uid &&
                       (
                         isAdmin() ||
                         (
                           incoming().approvalStatus == 'PENDING' &&
                           incoming().rejectionReason == '' &&
                           (!('reviewedBy' in incoming()) || incoming().reviewedBy == null) &&
                           (!('reviewedAt' in incoming()) || incoming().reviewedAt == null)
                         )
                       );

      allow update: if isSignedIn() &&
                       isValidId(nurseId) &&
                       isValidNurse(incoming()) &&
                       incoming().submittedByUid == existing().submittedByUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'fatherName', 'motherName', 'nurseCategory',
                             'bnmcNumber', 'govtUid', 'designation', 'qualification',
                             'educations', 'specialty', 'division', 'district', 'upazila',
                             'address', 'hospitalName', 'phone', 'whatsapp',
                             'email', 'bloodGroup', 'availabilityStatus', 'experienceYears', 'bio',
                             'approvalStatus', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().submittedByUid == request.auth.uid &&
                           existing().approvalStatus != 'REJECTED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'availabilityStatus', 'phone', 'whatsapp', 'address', 'bio', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(nurseId) && (
        isAdmin() ||
        (existing().submittedByUid == request.auth.uid && existing().approvalStatus == 'PENDING')
      );
    }

    // 6. Transfer Requests Collection Rules
    match /transfer_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().requestedByUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().requestedByUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().keys().hasAll([
                         'nurseId', 'nurseName', 'bnmcNumber', 'requestedByUid',
                         'currentHospitalName', 'currentDivision', 'currentDistrict',
                         'newHospitalName', 'newDivision', 'newDistrict',
                         'transferNote', 'status', 'rejectionReason', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'nurseId', 'nurseName', 'bnmcNumber', 'requestedByUid',
                         'currentCategory', 'newCategory', 'newGovtUid', 'newDesignation',
                         'currentHospitalName', 'currentDivision', 'currentDistrict', 'currentUpazila',
                         'newHospitalName', 'newDivision', 'newDistrict', 'newUpazila',
                         'transferNote', 'status', 'rejectionReason', 'reviewedBy', 'reviewedAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTransferRequest(incoming()) &&
                       incoming().requestedByUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().rejectionReason == '' &&
                       (!('reviewedBy' in incoming()) || incoming().reviewedBy == null) &&
                       (!('reviewedAt' in incoming()) || incoming().reviewedAt == null) &&
                       exists(/databases/$(database)/documents/nurses/$(incoming().nurseId)) &&
                       get(/databases/$(database)/documents/nurses/$(incoming().nurseId)).data.submittedByUid == request.auth.uid &&
                       get(/databases/$(database)/documents/nurses/$(incoming().nurseId)).data.approvalStatus == 'APPROVED';

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       isAdmin() &&
                       isValidTransferRequest(incoming()) &&
                       incoming().nurseId == existing().nurseId &&
                       incoming().requestedByUid == existing().requestedByUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(requestId) && (
        isAdmin() ||
        (existing().requestedByUid == request.auth.uid && existing().status == 'PENDING')
      );
    }

    // 7. Live Remote Config & Broadcast Notice
    match /app_config/{configId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       configId == 'live_notice' &&
                       isAdmin() &&
                       incoming().keys().hasAll(['title', 'message', 'active', 'updatedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'message', 'active', 'updatedBy', 'createdAt', 'updatedAt']) &&
                       isValidLiveNotice(incoming());

      allow update: if isSignedIn() &&
                       configId == 'live_notice' &&
                       isAdmin() &&
                       isValidLiveNotice(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'message', 'active', 'updatedBy', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && configId == 'live_notice' && isAdmin();
    }
  }
}
